{
  "name": "@listulator/server",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lists:generate": "tsx src/tools/generateList.ts",
    "lists:index": "tsx src/tools/generateListsIndex.ts",
    "platforms:generate": "tsx src/tools/generatePlatforms.ts",
    "platforms:check": "tsx src/tools/checkPlatforms.ts",
    "version:set": "tsx src/tools/setVersion.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.4.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13"
  }
}
