{
  "name": "listulator",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hostable completionist tracker for serialized media — finish the whole list.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @listulator/server",
    "dev:web": "npm run dev -w @listulator/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @listulator/server",
    "db:generate": "npm run db:generate -w @listulator/server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
