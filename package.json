{
  "name": "listulator",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "A self-hostable completionist tracker for serialized media — finish the whole list.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @listulator/server",
    "dev:web": "npm run dev -w @listulator/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @listulator/server",
    "db:generate": "npm run db:generate -w @listulator/server",
    "notices": "tsx server/src/tools/generateThirdPartyNotices.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "allowScripts": {
    "esbuild": false,
    "better-sqlite3": false,
    "fsevents": false
  }
}
