# Copy to .env and fill in what you need. Every setting has a working default,
# so the app runs with no .env at all — you only need this for API search.
#
# .env is gitignored. Never commit real keys.

# --- Server ---------------------------------------------------------------
# PORT=3001
# HOST=127.0.0.1
# The server only answers requests addressed to this machine (localhost,
# 127.0.0.1, ::1) or to the address in HOST. To reach it under another name
# (HOST=0.0.0.0, then a phone or another computer), list that name here. This is
# not a login: anyone on your network using an allowed name gets in.
# ALLOWED_HOSTS=nas.local,192.168.1.20
# DATABASE_PATH=data/listulator.sqlite

# Single-user mode is the point of this app: one implicit local user, no login.
# Turning it off is not supported yet and every request will answer 501.
# SINGLE_USER_MODE=true

# Where the suggestion strategy files live. Point this outside the repo if you
# want your tuning kept out of git.
# STRATEGIES_DIR=/path/to/your/strategies

# Drop a custom-list .yaml/.yml file here, then POST /api/lists/scan-folder
# (or whatever the UI's "check folder" action calls) to import it — task 7.3.
# A file that imports successfully moves to <dir>/admitted/; one that fails
# to parse moves to <dir>/refused_entry/ and is reported, not silently
# skipped. Defaults to server/list_customs/.
# LISTS_DROP_DIR=/path/to/your/list_customs

# --- Search sources -------------------------------------------------------
# Each is optional. Without a key, that category simply has no search and you
# add items by hand — nothing breaks.
#
# MusicBrainz (music) needs no key and is always on.
# Open Library (books) needs no key.

# themoviedb.org -> Settings -> API (free, non-commercial use)
# TMDB_API_KEY=

# dev.twitch.tv/console/apps -> register an app, then use its id and secret
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=

# comicvine.gamespot.com/api (free, requires an account)
# COMIC_VINE_API_KEY=

# YouTube Data API v3. More setup than the others — see README:
#   console.cloud.google.com -> new project
#   -> enable "YouTube Data API v3" -> Credentials -> Create credentials -> API key
# No billing account needed; the free quota is 10,000 units/day. Searching by
# name costs 100 units a time, so roughly 100 searches a day; pasting a link or
# an @handle costs about 1.
# YOUTUBE_API_KEY=
