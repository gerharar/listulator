{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Listulator",
  "version": "1.0.0-rc.1",
  "identifier": "com.listulator.desktop",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @listulator/web",
    "beforeBuildCommand": "npm run build -w @listulator/web"
  },
  "app": {
    "windows": [
      {
        "title": "Listulator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'sha256-YEercZJImS+vUX2bz7vkQ0aA4rtBIPLuCEWz+yraQ/g='",
        "img-src": "'self'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.themoviedb.org https://openlibrary.org https://en.wikipedia.org https://www.googleapis.com https://raw.githubusercontent.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../isolation"
        }
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczOEZGNDI3NzI1MjY1MTEKUldRUlpWSnlKL1NQYzREUFRLZ0M3dXRCZDMxdE5BQlowRkE5RHRZV0NVVUNjWjk3ZHRwRnEwTzUK",
      "endpoints": [
        "https://github.com/gerharar/listulator/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE.md": "NOTICE.md",
      "../../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
