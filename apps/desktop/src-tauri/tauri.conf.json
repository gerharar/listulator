{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Listulator",
  "version": "0.1.0",
  "identifier": "com.listulator.desktop",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @listulator/web",
    "beforeBuildCommand": "npm run build -w @listulator/web"
  },
  "app": {
    "windows": [
      {
        "title": "Listulator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.themoviedb.org https://openlibrary.org https://en.wikipedia.org https://www.googleapis.com https://raw.githubusercontent.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE.md": "NOTICE.md",
      "../../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
