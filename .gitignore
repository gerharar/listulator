# Dependencies
node_modules/

# Build output
dist/
build/
.vite/

# Test artifacts
coverage/

# Local database (never commit personal consumption data)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/

# Local filesystem-drop folder for custom lists (task 7.3) — a self-hoster's
# own dropped files, admitted/refused, never the repo's own content.
list_customs/

# Secrets / local config
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.log
npm-debug.log*

# NOTE: /config/strategies/*.json is deliberately NOT ignored — the shipped
# suggestion strategies are tracked so self-hosters can read and tune them.
# See SPEC.md §6.
